# HelpDesk external API key (X-API-Key). Server-side only — never exposed to the browser.
API_KEY_HELPDESK=

# Avada webhook signing secret. Required and displayed exactly once; regenerating
# it means editing the webhook in Avada admin.
WEBHOOK_SECRET=

# Login. Required: the API refuses to start without both, because the board
# carries real merchant data and must never come up unauthenticated.
# Generate the hash with `bun run auth:hash` and paste the whole line it prints.
# It is base64: an argon2 hash is full of `$`, which `bun --env-file` would
# expand as shell variables.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=

# Optional additional accounts. Number pairs from 2 through 20. A half-pair or
# unusable hash is logged with the offending key and skipped; a duplicate name
# keeps the first account and logs the later name key.
# AUTH_USER_2_NAME=
# AUTH_USER_2_HASH=

# Optional overrides
# PORT=8787
# DATABASE_PATH=data/board.db
# CACHE_TTL_MS=300000
# HELPDESK_APP_NAME=JOY Loyalty
# HELPDESK_YEAR=2026
# HELPDESK_BASE_URL=https://helpdesk.avada.net/api/external

# Session lifetime, refreshed on every request. Default 7 days.
# SESSION_TTL_MS=604800000

# `Secure` on the session cookie. On by default. Set to false ONLY for local
# http development — over plain http a Secure cookie is never sent and no login
# will stick.
# COOKIE_SECURE=false

# Believe X-Forwarded-For. Set true ONLY when a reverse proxy is actually in
# front (the VPS Caddy). With no proxy, a client can set the header itself and
# get a fresh bucket for every login guess.
# TRUST_PROXY=true

# Built web app served next to /api. Defaults to apps/web/dist, absent in a
# source checkout, set by the Dockerfile in the container.
# WEB_DIST_PATH=/app/apps/web/dist
