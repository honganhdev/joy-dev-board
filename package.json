{
  "name": "joy-dev-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
