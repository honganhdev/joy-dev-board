{
  "name": "joy-dev-board",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "test": "bun test",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck",
    "fixture:pull": "bun run --cwd apps/api fixture:pull",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:backup": "bun run --cwd apps/api db:backup",
    "auth:hash": "bun run --cwd apps/api auth:hash",
    "mcp:issue": "bun run --cwd apps/api mcp:issue",
    "mcp:revoke": "bun run --cwd apps/api mcp:revoke"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
