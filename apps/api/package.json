{
  "name": "@joy-dev-board/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "fixture:pull": "bun --env-file=../../.env scripts/pull-fixture.ts",
    "db:generate": "drizzle-kit generate",
    "db:backup": "bun --env-file=../../.env scripts/backup-db.ts",
    "auth:hash": "bun scripts/hash-password.ts",
    "mcp:issue": "bun --env-file=../../.env scripts/issue-token.ts",
    "mcp:revoke": "bun --env-file=../../.env scripts/revoke-token.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
